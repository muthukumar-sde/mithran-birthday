datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model VisitLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  timestamp   String
  ip          String
  city        String   @default("Unknown City")
  region      String   @default("Unknown Region")
  country     String   @default("Unknown Country")
  countryCode String   @default("XX")
  org         String   @default("Unknown ISP")
  latitude    Float?
  longitude   Float?
  userAgent   String
  device      String
  browser     String
  osName      String
  screen      String   @default("Unknown")
  language    String   @default("Unknown")
  referrer    String   @default("Direct")
  path        String   @default("/")
}
